# ==============================================================================
# STRAKLY GYM MANAGEMENT SYSTEM — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your actual project credentials:
#   cp .env.example .env
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key-for-session-management
PORT=5000

# Gym Facility Brand Defaults (Configurable via Admin Portal)
GYM_NAME="Strakly Fitness Facility"
GYM_PHONE="+254 700 123 456"
GYM_EMAIL="info@strakly.com"

# Supabase Project Configuration (Obtained from Supabase Dashboard -> Project Settings -> API)
# The application will start gracefully even before these credentials are configured!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Storage Buckets (Create these in Supabase Storage Dashboard):
# 1. 'gym-public' (Public bucket for facility photos, equipment, exercise assets)
# 2. 'avatars' (Public bucket for profile photos)
# 3. 'community-uploads' (Public bucket for user posts and progress photos)

# Cloudflare Turnstile Bot Protection Configuration
# Obtain your site and secret keys from the Cloudflare Dashboard -> Turnstile
# For development/testing, Cloudflare provides dummy test keys:
#   Site Key (Always passes): 1x00000000000000000000AA
#   Secret Key (Always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
